# Root .gitignore - Monorepo for SHELFLINE
# Backend and frontend have their own .gitignore files
# This file only covers root-level artifacts

# Python (root-level only)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Test artifacts
test-results/
coverage/

# Misc
*.tmp
*.temp